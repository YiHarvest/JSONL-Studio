{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSONL Studio",
  "mainBinaryName": "jsonl-studio",
  "version": "0.1.0-beta.2",
  "identifier": "io.github.yiharvest.jsonlstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JSONL Studio",
        "width": 1200,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": ["dmg", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Local JSONL and NDJSON reader",
    "fileAssociations": [
      {
        "ext": ["jsonl", "ndjson"],
        "name": "JSON Lines",
        "description": "JSON Lines document",
        "mimeType": "application/x-ndjson",
        "role": "Editor"
      }
    ]
  }
}
